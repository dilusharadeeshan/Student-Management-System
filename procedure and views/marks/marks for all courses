CREATE VIEW vw_ENG1222_marks AS
SELECT 
    e.Reg_no,
    e.Course_code,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'ENG1222'
              AND Reg_no = e.Reg_no 
              AND Marks_type = 'Assignment_1'), 0) AS `Assignment_1(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'ENG1222'
              AND Reg_no = e.Reg_no 
              AND Marks_type = 'Assignment_2'), 0) AS `Assignment_2(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'ENG1222'
              AND Reg_no = e.Reg_no  
              AND Marks_type = 'Mid_theory'), 0) AS `Mid_theory(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'ENG1222'
              AND Reg_no = e.Reg_no  
              AND Marks_type = 'End_theory'), 0) AS `End_theory(100%)`,
    (
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no 
                  AND Marks_type = 'Assignment_1'), 0)*0.1
        +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no 
                  AND Marks_type = 'Assignment_2'), 0)*0.1
        +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no  
                  AND Marks_type = 'Mid_theory'), 0)*0.1
    ) AS `Total_CA_marks(30%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'ENG1222'
              AND Reg_no = e.Reg_no  
              AND Marks_type = 'End_theory'), 0)*0.7 AS `Total_End_marks(70%)`,
    (
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no 
                  AND Marks_type = 'Assignment_1'), 0)*0.1
        +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no 
                  AND Marks_type = 'Assignment_2'), 0)*0.1
        +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no  
                  AND Marks_type = 'Mid_theory'), 0)*0.1
        +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'ENG1222'
                  AND Reg_no = e.Reg_no  
                  AND Marks_type = 'End_theory'), 0)*0.7
    ) AS `Final_marks(100%)`
FROM 
    enrollment e
WHERE 
    e.Course_code = 'ENG1222';




