CREATE VIEW vw_TMS1233_marks AS
SELECT DISTINCT
    m.Reg_no,
    m.Course_code,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'TMS1233'
              AND Reg_no = m.Reg_no 
              AND Marks_type = 'Quiz_1'), 0) AS `Quiz_1(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'TMS1233'
              AND Reg_no = m.Reg_no 
              AND Marks_type = 'Quiz_2'), 0) AS `Quiz_2(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'TMS1233'
              AND Reg_no = m.Reg_no 
              AND Marks_type = 'Mid_theory'), 0) AS `Mid_theory(100%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'TMS1233'
              AND Reg_no = m.Reg_no 
              AND Marks_type = 'End_theory'), 0) AS `End_theory(100%)`,
    (
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Quiz_1'), 0) * 0.1 +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Quiz_2'), 0) * 0.1 +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Mid_theory'), 0) * 0.2
    ) AS `Total_CA_Marks(40%)`,
    IFNULL((SELECT Marks_value FROM mark 
            WHERE Course_code = 'TMS1233'
              AND Reg_no = m.Reg_no 
              AND Marks_type = 'End_theory'), 0) * 0.6 AS `Total_End_Marks(60%)`,
    (
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Quiz_1'), 0) * 0.1 +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Quiz_2'), 0) * 0.1 +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'Mid_theory'), 0) * 0.2 +
        IFNULL((SELECT Marks_value FROM mark 
                WHERE Course_code = 'TMS1233'
                  AND Reg_no = m.Reg_no 
                  AND Marks_type = 'End_theory'), 0) * 0.6
    ) AS `Final_Marks(100%)`
FROM 
    mark m
WHERE 
    m.Course_code = 'TMS1233';



